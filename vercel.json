{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "headers": [
        {
          "value": "no-cache, no-store, must-revalidate",
          "key": "Cache-Control"
        },
        {
          "value": "application/javascript",
          "key": "Content-Type"
        }
      ],
      "source": "/sw.js"
    },
    {
      "headers": [
        {
          "value": "no-cache",
          "key": "Cache-Control"
        },
        {
          "value": "application/manifest+json",
          "key": "Content-Type"
        }
      ],
      "source": "/manifest.webmanifest"
    },
    {
      "headers": [
        {
          "value": "public, max-age=31536000, immutable",
          "key": "Cache-Control"
        }
      ],
      "source": "/assets/(.*)"
    }
  ]
}
